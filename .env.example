# Copy to .env.development (dev) or .env.production (build). Never commit .env.*
# 复制为 .env.development（开发）或 .env.production （构建）。.env.* 不入库。

# Site name shown in the console
NUXT_PUBLIC_SITE_NAME=EasyTV
# Backend (easytv-api) base URL. Local: http://localhost:8383
NUXT_PUBLIC_API_BASE_URL=http://localhost:8383
# Creator studio (easytv-web): "open site" link, review → player jumps, static assets.
# Local: http://localhost:3005
NUXT_PUBLIC_STUDIO_URL=http://localhost:3005
# Partner console (easytv-partner): "open partner console" on the Partners page.
# Local: http://localhost:3010
NUXT_PUBLIC_PARTNER_URL=http://localhost:3010
