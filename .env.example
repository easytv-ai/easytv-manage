# Copy to .env.development (dev) or .env.production (build). Never commit .env.*
# 复制为 .env.development（开发）或 .env.production（构建）。.env.* 不入库。

# Site name shown in the console
NUXT_PUBLIC_SITE_NAME=EasyTV
# Backend (easytv-api) base URL
NUXT_PUBLIC_API_BASE_URL=http://localhost:8383
# Creator studio (easytv-web) URL: "open site" link, review → player jumps, static assets
NUXT_PUBLIC_STUDIO_URL=http://localhost:3005
